# Copy to .env.local for local development. NEVER commit real values.
# On Vercel set these under Project Settings > Environment Variables.

# ---------- Site ----------
# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap, e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (REQUIRED for accounts, listings, bookings, enquiries) ----------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon" / "publishable" key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. The service-role key bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Used only for: private enquiry-photo uploads and looking up recipient e-mails for notifications.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Business contact details (leave empty until you have the real, official values) ----------
# WhatsApp business number: digits only with country code, e.g. 9198XXXXXXXX (can also be set in Admin > Settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---------- Transactional e-mail (optional; notifications are skipped and flagged when unset) ----------
# https://resend.com — create an API key and verify your sending domain.
RESEND_API_KEY=
# e.g. "Hasiru Nidhi <bookings@yourdomain.com>" (domain must be verified with the provider)
EMAIL_FROM=
# Where new enquiries / applications / listing submissions are announced.
ADMIN_NOTIFY_EMAIL=
